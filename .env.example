# Copy to .env and fill in if/when you move off the local Hardhat chain.
# Nothing here is required for the local-blockchain setup described in the README.

# Only needed if you switch blockchain/hardhat.config.js to a public testnet later:
# TESTNET_RPC_URL=https://rpc-amoy.polygon.technology
# DEPLOYER_PRIVATE_KEY=

# Only needed if/when you get IMD API or NASA FIRMS access (see docs/live_data_sources.md):
# IMD_API_KEY=
# FIRMS_MAP_KEY=
